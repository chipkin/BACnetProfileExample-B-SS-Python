      "value": "B-SS - BACnet Smart Sensor"
    },
    "productDescription": {
      "provenance": "user-entered",
      "value": "A minimal read-only BACnet/IP sensing device built on the CAS BACnet Stack. It presents three sensor objects (Analog Input, Binary Input, Multi-State Input) whose readings follow a sensor Simulation, answers ReadProperty for every required property of every object, reports a broken sensor through Analog Input 1's Reliability and the FAULT bit of Status_Flags, and is discoverable by Who-Is / I-Am and Who-Has / I-Have. It is a tutorial for implementers of the B-SS profile."
    },
    "productName": {
      "provenance": "user-entered",
      "value": "CAS BACnet Stack Example - B-SS (Python)"
    },
    "specialFunctionality": {
      "provenance": "derived",
      "value": "none"
    }
  },
